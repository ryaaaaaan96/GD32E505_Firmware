             result = FDB_ERASE_ERR;
         }
+#elif defined(FDB_USING_AMEMORY_MODE)
+        aMemoryEraseRequest_t request;
+        aStatus_t status = aDataBaseStorageError();
+
+        if (status == A_STATUS_OK) {
+            aMemoryEraseRequestStructInit(&request);
+            request.address = addr;
+            request.size = size;
+            request.timeout = aDataBaseStorageTimeout();
+            status = aMemoryErase(db->storage.memory, &request);
+            aDataBaseStorageFail(status);
+        }
+        if (status != A_STATUS_OK) result = FDB_ERASE_ERR;
 #endif
     }
 
@@ -298,6 +328,10 @@ fdb_err_t _fdb_flash_erase(fdb_db_t db, uint32_t addr, size_t size)
 
 fdb_err_t _fdb_flash_write(fdb_db_t db, uint32_t addr, const void *buf, size_t size, bool sync)
 {
