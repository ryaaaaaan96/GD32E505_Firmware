+static void index_update(fdb_kvdb_t db, const char *key, size_t len,
+                         uint32_t old_addr, uint32_t new_addr)
+{
+    uint32_t *slot = db->index_slot
+        ? db->index_slot(db->index_context, key, len) : NULL;
+
+    if (slot && (new_addr != FDB_DATA_UNUSED || *slot == old_addr)) {
+        *slot = new_addr;
+    }
